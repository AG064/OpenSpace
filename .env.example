# OpenSpace Configuration (AG064 Fork)
# Forked from HKUDS/OpenSpace - adapted for MiniMax + OpenClaw bridge

# ============ LLM Provider (choose one) ============

# OPTION 1: MiniMax (recommended when you have API key)
# Get key at: https://console.minimaxi.com/
# MINIMAX_API_KEY=your_minimax_key_here
# MINIMAX_API_BASE=https://api.minimax.chat/v1

# OPTION 2: OpenRouter (we have this already)
OPENROUTER_API_KEY=your_openrouter_key_here

# OPTION 3: NVIDIA (free models via api.nvidia.com)
# NVIDIA_API_KEY=your_nvidia_key_here

# ============ LiteLLM Config ============
# LiteLLM will auto-detect the provider based on model name
LITELLM_MASTER_KEY=local123

# ============ OpenClaw Bridge ============
# When running as MCP server for AG-Claw
AG_CLAW_BRIDGE=true
AG_CLAW_SKILLS_DIR=~/.openclaw/skills
OPENSPACE_HOST=127.0.0.1
OPENSPACE_PORT=8080
